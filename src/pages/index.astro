---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/nav.astro';
import WorkGrid from '../components/workGrid.astro';
import Footer from '../components/footer.astro';
---

<Layout>
  <Nav />
  <div class="homeWorkGrid">
    <WorkGrid />
  </div>
  <Footer />
</Layout>

<style>

  .pageTitle {
    position: sticky;
    top: 0;
    z-index: 0;
    background: transparent;
    margin-top: 70px;
    font-size: 20rem;
    font-weight: bold;
    text-align: right;
  }

  .homeWorkGrid {
    padding-top: 6rem;
  }
</style>
