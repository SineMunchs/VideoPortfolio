---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/nav.astro';
import WorkGrid from '../components/workGrid.astro';
---

<Layout>
  <Nav />
  <h1 class="pageTitle">work</h1>
  <WorkGrid />
</Layout>

<style>
  :root {
    --font: 'Helvetica', Arial, sans-serif;
  }

  html, body {
    font-family: var(--font);
  }

  .pageTitle {
    margin-top: 70px;
    font-family: var(--font);
    font-size: 8rem;
    font-weight: bold;
    text-align: right;
  }
</style>
