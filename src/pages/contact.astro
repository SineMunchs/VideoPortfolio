---
import Nav from "../components/nav.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
---

<Layout>
  <Nav />
  <h1 class="pageTitle">Contact</h1>
  <div class="contact-info">
    <div class="contact-row">
      <button
        type="button"
        class="information tooltip-parent"
        id="copy-email"
        data-copy="paddyblog@gmail.com"
      >
        <span>paddyblog@gmail.com</span>
        <span class="footer-tooltip">Email copied</span>
      </button>
    </div>
    <div class="contact-row">
      <button
        type="button"
        class="information tooltip-parent"
        id="copy-phone"
        data-copy="+44 7906 552 769"
      >
        <span>(+44) 7906 552 769</span>
        <span class="footer-tooltip">number copied</span>
      </button>
    </div>
    <div class="contact-row">
      <a
        href="https://www.instagram.com/paddygomulski/"
        target="_blank"
        rel="noopener"
        aria-label="Instagram"
        class="tooltip-parent instagram-link"
      >
        Instagram
      </a>
    </div>
  </div>
  <Footer />
</Layout>

<script>
  function setupCopy(id) {
    const button = document.getElementById(id);
    if (!button) return;

    const hideTooltip = () => button.classList.remove("show-tooltip");

    button.addEventListener("mousedown", () => {
      button.classList.add("show-tooltip");
    });

    button.addEventListener("mouseup", () => {
      window.setTimeout(hideTooltip, 400);
    });

    button.addEventListener("mouseleave", hideTooltip);

    button.addEventListener("click", async () => {
      const value = button.dataset.copy;
      if (!value) return;

      try {
        await navigator.clipboard.writeText(value);
      } catch (error) {
        console.error("Failed to copy value", error);
      }
    });
  }

  setupCopy("copy-email");
  setupCopy("copy-phone");
</script>

<style>
  :root {
    --contact-tooltip-bg: #fff;
    --contact-tooltip-text: #000;
    --contact-title: #121212;
  }

  .pageTitle {
    margin-top: 70px;
    font-size: 3rem;
    font-weight: bold;
    text-align: right;
    color: var(--contact-title);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .contact-row {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .tooltip-parent {
    position: relative;
  }

  .information,
  .instagram-link {
    position: relative;
    margin: 0;
    padding: 0.2rem 0.6rem;
    border: none;
    background: none;
    font-size: 0.8rem;
    text-align: right;
    color: inherit;
    cursor: pointer;
  }

  .instagram-link {
    text-decoration: none;
    user-select: all;
  }

  .footer-tooltip {
    position: absolute;
    right: 100%;
    top: 50%;
    margin-right: 0.5rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: var(--contact-tooltip-bg);
    color: var(--contact-tooltip-text);
    font-size: 0.8rem;
    white-space: nowrap;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-50%);
    transition: opacity 0.2s;
    z-index: 200;
  }

  .tooltip-parent.show-tooltip .footer-tooltip {
    visibility: visible;
    opacity: 1;
  }
</style>
