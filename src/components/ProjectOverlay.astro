<!-- Project Overlay -->
<div class="overlay" data-overlay aria-hidden="true">
  <div class="overlay-panel">
    <button
      class="overlay-close"
      type="button"
      data-overlay-close
      aria-label="Close project overlay"
    >
      close
    </button>

    <div class="overlay-body">
      <div class="overlay-media">
        <mux-player
          class="overlay-video overlay-mux"
          data-overlay-mux
          muted
          autoplay
          hidden
        ></mux-player>
        <video
          class="overlay-video overlay-native"
          playsinline
          controls
          muted
          autoplay
          data-overlay-video
        >
          <source data-overlay-source-webm type="video/webm" />
          <source data-overlay-source type="video/mp4" />
        </video>
        <a class="overlay-link" href="#" data-overlay-link>open project</a>
      </div>

      <div class="overlay-meta">
        <div class="overlay-project" data-overlay-project></div>
        <div class="overlay-sub" data-overlay-sub></div>
        <div class="overlay-copy">
          <p data-overlay-description></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    // Overlay elements
    const overlay = document.querySelector("[data-overlay]");
    const closeBtn = overlay?.querySelector("[data-overlay-close]");
    const projectEl = overlay?.querySelector("[data-overlay-project]");
    const subEl = overlay?.querySelector("[data-overlay-sub]");
    const descriptionEl = overlay?.querySelector("[data-overlay-description]");
    const linkEl = overlay?.querySelector("[data-overlay-link]");
    const muxEl = overlay?.querySelector("[data-overlay-mux]");
    const nativeVideoEl = overlay?.querySelector("[data-overlay-video]");
    const sourceEl = overlay?.querySelector("[data-overlay-source]");
    const webmSourceEl = overlay?.querySelector("[data-overlay-source-webm]");

    // Player helpers
    const getActivePlayer = () => {
      if (muxEl && !muxEl.hasAttribute("hidden")) return muxEl;
      return nativeVideoEl;
    };

    const getMedia = (el) => {
      if (!el) return null;
      if (typeof el.play === "function") return el;
      if (el.media && typeof el.media.play === "function") return el.media;
      return null;
    };

    const openFullscreen = async () => {
      const el = getMedia(getActivePlayer());
      if (!el) return;

      const request =
        el.requestFullscreen ||
        el.webkitRequestFullscreen ||
        el.msRequestFullscreen;

      if (request) {
        try {
          await request.call(el);
          await el.play?.();
          return;
        } catch {}
      }

      if (linkEl?.href) {
        window.open(linkEl.href, "_blank", "noopener,noreferrer");
      }
    };

    // Overlay content sync
    const updateOverlay = (item) => {
      if (!overlay || !sourceEl) return;

      const project = item.dataset.project || "";
      const role = item.dataset.role || "";
      const year = item.dataset.year || "";
      const title = item.dataset.title || "";
      const href = item.dataset.href || "#";
      const poster = item.dataset.poster || "";
      const video = item.dataset.video || "";
      const videoWebm = item.dataset.videoWebm || "";
      const playbackId = item.dataset.playbackId || "";
      const overlayText = item.dataset.overlayText || "";

      if (projectEl) projectEl.textContent = project || title;
      if (subEl) subEl.textContent = [role, title, year].filter(Boolean).join(" • ");
      if (descriptionEl) descriptionEl.innerHTML = overlayText;
      if (linkEl) linkEl.href = href;

      if (playbackId) {
        if (muxEl) {
          muxEl.removeAttribute("hidden");
          muxEl.setAttribute("playback-id", playbackId);

          if (poster) {
            muxEl.setAttribute("poster", poster);
          } else {
            muxEl.removeAttribute("poster");
          }
        }

        nativeVideoEl?.setAttribute("hidden", "true");
      } else {
        muxEl?.setAttribute("hidden", "true");

        if (poster) {
          nativeVideoEl?.setAttribute("poster", poster);
        } else {
          nativeVideoEl?.removeAttribute("poster");
        }

        if (webmSourceEl) {
          if (videoWebm) {
            webmSourceEl.src = videoWebm;
          } else {
            webmSourceEl.removeAttribute("src");
          }
        }

        sourceEl.src = video;
        nativeVideoEl?.removeAttribute("hidden");
        nativeVideoEl?.load();
      }
    };

    // Overlay open and close
    const openOverlay = (item) => {
      if (!overlay) return;

      updateOverlay(item);
      overlay.classList.add("is-open");
      overlay.removeAttribute("aria-hidden");

      requestAnimationFrame(() => {
        try {
          getMedia(getActivePlayer())?.play();
        } catch {}
      });
    };

    const closeOverlay = () => {
      if (!overlay) return;

      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      getMedia(nativeVideoEl)?.pause();
      getMedia(muxEl)?.pause();
    };

    // Overlay events
    closeBtn?.addEventListener("click", closeOverlay);

    overlay?.addEventListener("click", (event) => {
      if (event.target === overlay) closeOverlay();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeOverlay();
    });

    linkEl?.addEventListener("click", (event) => {
      event.preventDefault();
      openFullscreen();
    });

    // Grid item interactions
    document.querySelectorAll(".workItem").forEach((item) => {
      const handleOpen = (event) => {
        if (event.type === "mousedown" && event.button !== 0) return;
        event.preventDefault();
        openOverlay(item);
      };

      item.addEventListener("mousedown", handleOpen);
      item.addEventListener("click", (event) => event.preventDefault());
      item.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openOverlay(item);
        }
      });
    });

    // Hover preview playback
    document.querySelectorAll("[data-hover-play]").forEach((element) => {
      const isPlayable =
        element.tagName === "VIDEO" ||
        element.tagName === "MUX-VIDEO" ||
        element.tagName === "MUX-PLAYER";

      if (!isPlayable) return;

      const play = async () => {
        try {
          element.muted = true;
          element.currentTime = 0;
          await element.play();
        } catch {}
      };

      const stop = () => {
        element.pause();
        element.currentTime = 0;
      };

      const wrap = element.closest("a");
      const targets = [element, wrap].filter(Boolean);

      targets.forEach((target) => {
        target.addEventListener("mouseenter", play);
        target.addEventListener("mouseleave", stop);
        target.addEventListener("focusin", play);
        target.addEventListener("focusout", stop);
      });
    });
  })();
</script>

<style>
  /* Overlay Shell */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    justify-content: flex-end;
    background: rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(1px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .overlay-panel {
    position: relative;
    width: min(720px, 95vw);
    height: 100%;
    padding: 32px 28px 40px;
    overflow-y: auto;
    background: #f8f8f8;
    color: #111;
    font-family: var(--font);
    box-shadow: -12px 0 40px rgba(0, 0, 0, 0.15);
    transform: translateX(100%);
    transition: transform 280ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .overlay.is-open .overlay-panel {
    transform: translateX(0);
  }

  /* Overlay Content */
  .overlay-close {
    position: absolute;
    top: 16px;
    right: 16px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-transform: lowercase;
  }

  .overlay-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 12px;
    align-items: start;
  }

  .overlay-media {
    position: sticky;
    top: 16px;
    display: grid;
    gap: 12px;
  }

  .overlay-meta {
    display: grid;
    gap: 10px;
  }

  .overlay-project {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.05;
  }

  .overlay-sub {
    font-size: 10px;
    letter-spacing: 0.01em;
    line-height: 1.3;
    opacity: 0.8;
  }

  .overlay-video {
    width: 100%;
    border: 1px solid #e6e6e6;
    background: #000;
  }

  .overlay-link {
    width: fit-content;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-decoration: none;
    text-transform: lowercase;
  }

  .overlay-copy {
    display: grid;
    gap: 12px;
    font-size: 14px;
    letter-spacing: 0.01em;
    line-height: 1.45;
  }

  .overlay-copy p {
    margin: 0;
  }

  /* Overlay Responsive */
  @media (max-width: 900px) {
    .overlay-body {
      grid-template-columns: 1fr;
    }

    .overlay-media {
      position: static;
    }

    .overlay-panel {
      width: 100%;
    }
  }
</style>
