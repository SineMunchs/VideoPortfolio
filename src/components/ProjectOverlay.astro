<!-- Project Overlay -->
<div class="overlay" data-overlay aria-hidden="true">
  <div class="overlay-panel">
    <button
      class="overlay-close"
      type="button"
      data-overlay-close
      aria-label="Close project overlay"
    >
      close
    </button>

    <div class="overlay-body">
      <div class="overlay-media">
        <div class="overlay-sticky-video">
          <mux-player
            class="overlay-video overlay-mux"
            data-overlay-mux
            muted
            autoplay
            hidden
          ></mux-player>
          <video
            class="overlay-video overlay-local"
            data-overlay-video
            muted
            autoplay
            playsinline
            loop
            hidden
            preload="metadata"
          ></video>
        </div>
        <a class="overlay-link" href="#" data-overlay-link>open project</a>
        <div class="overlay-meta">
          <div class="overlay-project" data-overlay-project></div>
          <div class="overlay-sub" data-overlay-sub></div>
        </div>
        <!-- overlay text hidden
        <div class="overlay-copy">
          <p data-overlay-description></p>
        </div>
        -->
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    // Overlay elements
    const overlay = document.querySelector("[data-overlay]");
    const closeBtn = overlay?.querySelector("[data-overlay-close]");
    const projectEl = overlay?.querySelector("[data-overlay-project]");
    const subEl = overlay?.querySelector("[data-overlay-sub]");
    const linkEl = overlay?.querySelector("[data-overlay-link]");
    const muxEl = overlay?.querySelector("[data-overlay-mux]");
    const localVideoEl = overlay?.querySelector("[data-overlay-video]");

    // Player helpers
    const getActivePlayer = () => {
      if (muxEl && !muxEl.hasAttribute("hidden")) return muxEl;
      if (localVideoEl && !localVideoEl.hasAttribute("hidden")) return localVideoEl;
      return null;
    };

    const getMedia = (el) => {
      if (!el) return null;
      if (typeof el.play === "function") return el;
      if (el.media && typeof el.media.play === "function") return el.media;
      return null;
    };

    const openFullscreen = async () => {
      const el = getMedia(getActivePlayer());
      if (!el) return;

      const request =
        el.requestFullscreen ||
        el.webkitRequestFullscreen ||
        el.msRequestFullscreen;

      if (request) {
        try {
          await request.call(el);
          await el.play?.();
          return;
        } catch {}
      }

      if (linkEl?.href) {
        window.open(linkEl.href, "_blank", "noopener,noreferrer");
      }
    };

    // Overlay content sync
    const updateOverlay = (item) => {
      if (!overlay) return;

      const project = item.dataset.project || "";
      const role = item.dataset.role || "";
      const year = item.dataset.year || "";
      const title = item.dataset.title || "";
      const href = item.dataset.href || "#";
      const poster = item.dataset.poster || "";
      const playbackId = item.dataset.playbackId || "";
      const videoSrc = item.dataset.video || "";
      const videoWebm = item.dataset.videoWebm || "";
      const orientation = item.dataset.orientation || "landscape";

      overlay.dataset.orientation = orientation;

      if (projectEl) projectEl.textContent = project || title;
      if (subEl) subEl.textContent = [role, title, year].filter(Boolean).join(" • ");
      if (linkEl) linkEl.href = href;

      if (playbackId && muxEl) {
        muxEl.removeAttribute("hidden");
        muxEl.setAttribute("playback-id", playbackId);

        if (poster) {
          muxEl.setAttribute("poster", poster);
        } else {
          muxEl.removeAttribute("poster");
        }
        if (localVideoEl) {
          localVideoEl.pause();
          localVideoEl.setAttribute("hidden", "true");
          localVideoEl.removeAttribute("poster");
          localVideoEl.removeAttribute("src");
          localVideoEl.innerHTML = "";
        }
      } else if (videoSrc && localVideoEl) {
        if (muxEl) {
          muxEl.setAttribute("hidden", "true");
          muxEl.removeAttribute("playback-id");
          muxEl.removeAttribute("poster");
        }

        localVideoEl.removeAttribute("hidden");
        if (poster) {
          localVideoEl.setAttribute("poster", poster);
        } else {
          localVideoEl.removeAttribute("poster");
        }

        const sources = [];
        if (videoWebm) {
          sources.push(`<source src="${videoWebm}" type="video/webm">`);
        }
        sources.push(`<source src="${videoSrc}" type="video/mp4">`);
        localVideoEl.innerHTML = sources.join("");
        localVideoEl.load();
      } else {
        if (muxEl) {
          muxEl.setAttribute("hidden", "true");
          muxEl.removeAttribute("playback-id");
          muxEl.removeAttribute("poster");
        }
        if (localVideoEl) {
          localVideoEl.pause();
          localVideoEl.setAttribute("hidden", "true");
          localVideoEl.removeAttribute("poster");
          localVideoEl.removeAttribute("src");
          localVideoEl.innerHTML = "";
        }
      }
    };

    // Overlay open and close
    const openOverlay = (item) => {
      if (!overlay) return;

      updateOverlay(item);
      overlay.classList.add("is-open");
      overlay.removeAttribute("aria-hidden");

      requestAnimationFrame(() => {
        try {
          getMedia(getActivePlayer())?.play();
        } catch {}
      });
    };

    const closeOverlay = () => {
      if (!overlay) return;

      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      getMedia(muxEl)?.pause();
      const localMedia = getMedia(localVideoEl);
      localMedia?.pause();
      if (localMedia && localMedia.tagName === "VIDEO") {
        try {
          localMedia.currentTime = 0;
          localMedia.load();
        } catch {}
      }
    };

    // Overlay events
    closeBtn?.addEventListener("click", closeOverlay);

    overlay?.addEventListener("click", (event) => {
      if (event.target === overlay) closeOverlay();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeOverlay();
    });

    linkEl?.addEventListener("click", (event) => {
      event.preventDefault();
      openFullscreen();
    });

    // Grid item interactions
    document.querySelectorAll(".workItem").forEach((item) => {
      let touchStartY = 0;
      let isTouchTap = false;

      // Touch: open on tap, ignore scrolls
      item.addEventListener("touchstart", (e) => {
        touchStartY = e.touches[0].clientY;
        isTouchTap = true;
      }, { passive: true });

      item.addEventListener("touchmove", () => {
        isTouchTap = false;
      }, { passive: true });

      item.addEventListener("touchend", (e) => {
        if (!isTouchTap) return;
        const dy = Math.abs(e.changedTouches[0].clientY - touchStartY);
        if (dy < 10) {
          e.preventDefault(); // prevent mousedown/click from double-firing
          openOverlay(item);
        }
      });

      // Mouse: existing desktop behaviour
      item.addEventListener("mousedown", (event) => {
        if (event.button !== 0) return;
        event.preventDefault();
        openOverlay(item);
      });

      item.addEventListener("click", (event) => event.preventDefault());
      item.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openOverlay(item);
        }
      });
    });

    // Hover preview playback
    const isPhoneView = window.matchMedia("(hover: none), (pointer: coarse), (max-width: 900px)").matches;
    const pauseOtherMobileMedia = (activeElement) => {
      document.querySelectorAll("video, mux-video, mux-player").forEach((candidate) => {
        if (candidate === activeElement) return;
        if (typeof candidate.pause === "function") {
          try {
            candidate.pause();
          } catch {}
        }
      });
    };

    document.querySelectorAll("[data-hover-play]").forEach((element) => {
      const isPlayable =
        element.tagName === "VIDEO" ||
        element.tagName === "MUX-VIDEO" ||
        element.tagName === "MUX-PLAYER";

      if (!isPlayable) return;

      let playTimer = null;

      const play = async () => {
        try {
          if (isPhoneView) pauseOtherMobileMedia(element);
          element.muted = true;
          element.playsInline = true;
          await element.play();
        } catch {}
      };

      const stop = () => {
        if (playTimer) { clearTimeout(playTimer); playTimer = null; } // cancel pending play
        element.pause();
        if (element.tagName === "VIDEO") {
          try {
            // Only reset via load() if the video has actually played.
            // Calling load() on a fresh (never-played) video wipes the
            // native poster and leaves a black frame while the reload runs.
            if (element.currentTime > 0) {
              element.currentTime = 0;
              element.load();
            }
          } catch {}
        }
      };

      if (isPhoneView) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
                // Show thumbnail for 1.5 s before the video starts
                if (!playTimer) {
                  playTimer = setTimeout(() => { playTimer = null; play(); }, 1500);
                }
              } else {
                stop(); // cancels the timer and pauses
              }
            });
          },
          { threshold: [0, 0.6, 1] }
        );
        observer.observe(element);
        return;
      }

      const wrap = element.closest("a");
      const targets = [element, wrap].filter(Boolean);

      targets.forEach((target) => {
        target.addEventListener("mouseenter", play);
        target.addEventListener("mouseleave", stop);
        target.addEventListener("focusin", play);
        target.addEventListener("focusout", stop);
      });
    });
  })();
</script>

<style>
  /* Overlay Shell */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    justify-content: flex-end;
    background: rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(1px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .overlay-panel {
    position: relative;
    width: min(900px, 98vw);
    height: 100%;
    box-sizing: border-box;
    padding: 10px 28px 40px;
    overflow: hidden;
    background: #f8f8f8;
    color: #434242;
    font-family: var(--font);
    box-shadow: -12px 0 40px rgba(0, 0, 0, 0.15);
    transform: translateX(100%);
    transition: transform 280ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .overlay.is-open .overlay-panel {
    transform: translateX(0);
  }

  /* Overlay Content */
  .overlay-close {
    position: relative;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    border-bottom: 1px solid transparent;
    font-size: 12px;
    letter-spacing: 0.01em;
    text-transform: lowercase;
    transition: border-color 160ms ease;
    /* larger tap target on touch */
    padding: 8px 4px;
    margin: -8px -4px;
    touch-action: manipulation;
  }

  .overlay-close:hover,
  .overlay-close:focus-visible,
  .overlay-link:hover,
  .overlay-link:focus-visible {
    border-bottom-color: currentColor;
  }

  .overlay-body {
    display: block;
    height: calc(100% - 28px);  
    overflow: hidden;
  }

  .overlay-media {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 12px;
    height: 100%;
    min-height: 0;
    width: 100%;
  }

  .overlay-sticky-video {
    position: sticky;
    top: 12px;          
    z-index: 1;
    background: #f8f8f8;
  }

  .overlay-meta {
    display: block;
  }

  .overlay-project {
    display: inline-block;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.05;
    margin-right: 10px;
  }

  .overlay-sub {
    display: inline-block;
    vertical-align: baseline;
    font-size: 10px;
    letter-spacing: 0.01em;
    line-height: 1.3;
    opacity: 0.8;
  }

  .overlay-video {
    display: block;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid #e6e6e6;
    background: #000;
  }

  .overlay-video[hidden] {
    display: none !important;
  }

  .overlay[data-orientation="portrait"] .overlay-media {
    width: 50%;
    margin-inline: 0;
  }

  .overlay[data-orientation="portrait"] .overlay-video {
    aspect-ratio: 9 / 16;
  }

  .overlay[data-orientation="portrait"] .overlay-mux {
    --media-object-fit: contain;
  }

  .overlay[data-orientation="portrait"] .overlay-link {
    justify-self: start;
  }

  @media (min-width: 901px) {
    .overlay[data-orientation="portrait"] .overlay-media {
      width: fit-content;
      max-width: 91%;
      margin-inline: 0;
    }

    .overlay[data-orientation="portrait"] .overlay-video {
      height: min(60vh, 820px);
      width: auto;
      max-width: 100%;
    }
  }

  .overlay-link {
    width: fit-content;
    justify-self: end;
    border-bottom: 1px solid transparent;
    margin-top: 16px;
    margin-bottom: 8px;
    color: inherit;
    font-size: 12px;
    letter-spacing: 0.01em;
    text-decoration: none;
    text-transform: lowercase;
    transition: border-color 160ms ease;
  }

  .overlay-copy {
    display: grid;
    gap: 20px;
    font-size: 14px;
    letter-spacing: 0.01em;
    line-height: 1.45;
    min-height: 0;
    overflow-y: auto;
    padding-right: 4px;
  }

  .overlay-copy p {
    margin: 0;
  }

  /* Overlay Responsive */
  @media (max-width: 900px) {
    .overlay-close {
      top: 4px;
    }

    .overlay-body {
      margin-top: 8px;
      height: calc(100% - 16px);
    }

    .overlay-media {
      gap: 8px;
    }

    .overlay-link {
      margin-top: 0px;
      margin-bottom: 0px;
    }

    .overlay-sticky-video {
      position: static;
    }

    .overlay-panel {
      width: 100%;
      padding-bottom: calc(40px + env(safe-area-inset-bottom));
    }
  }
</style>
