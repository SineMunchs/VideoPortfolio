---
import items from "../data/work.json";
import MuxPlayerFrame from "./MuxPlayerFrame.vue";
import ProjectOverlay from "./ProjectOverlay.astro";

type WorkItem = {
  id: string;
  href: string;
  poster: string;
  videoSrc?: string;
  videoWebm?: string;
  muxPlaybackId?: string;
  orientation?: "landscape" | "portrait";
  tag?: string;
  role: string;
  title: string;
  year: string;
  project: string;
  overlay?: string;
};

const workItems = items as WorkItem[];
---

<!-- Work Grid -->
<section class={`workRow${Astro.props.class ? ` ${Astro.props.class}` : ''}`} aria-label="Selected work">
  {workItems.map((item) => {
    const hasMux = Boolean(item.muxPlaybackId);

    return (
      <article
        class="workItem"
        id={item.id}
        tabindex="0"
        data-id={item.id}
        data-project={item.project}
        data-title={item.title}
        data-year={item.year}
        data-role={item.role}
        data-tag={item.tag ?? "watch"}
        data-video={item.videoSrc ?? ""}
        data-video-webm={item.videoWebm ?? ""}
        data-poster={item.poster}
        data-playback-id={item.muxPlaybackId ?? ""}
        data-orientation={item.orientation ?? "landscape"}
        data-href={item.href}
        data-overlay-text={item.overlay ?? ""}
      >
        <div class="cardBody">
          <a class="media" href={item.href} aria-label={`Open ${item.project}`}>
            {hasMux ? (
              <MuxPlayerFrame
                playbackId={item.muxPlaybackId}
                poster={item.poster}
                autoplay={false}
                loop={false}
                muted={true}
                data-hover-play
                client:only="vue"
              />
            ) : (
              <video
                class="vid"
                muted
                playsinline
                preload="metadata"
                poster={item.poster}
                data-hover-play
              >
                {item.videoWebm && <source src={item.videoWebm} type="video/webm" />}
                {item.videoSrc && <source src={item.videoSrc} type="video/mp4" />}
              </video>
            )}
            <span class="watch">{item.tag ?? "watch"}</span>
          </a>
          <div class="metaGrid" aria-label="Project metadata">
            <div class="meta metaInline">
              <span class="project">{item.project}</span>
              <span class="metaRole">{item.role}</span>
              {item.title && <span>{item.title}</span>}
              <span class="metaYear">{item.year}</span>
            </div>
          </div>
        </div>
      </article>
    );
  })}
</section>

<style>
/* Grid Mux Controls */
mux-player.no-controls::part(control-bar),
mux-player.no-controls::part(play-button),
mux-player.no-controls::part(center-play-button),
mux-player.no-controls::part(top-play-button) {
  display: none !important;
}

mux-player.no-controls [part~="center-play-button"],
mux-player.no-controls [part~="play-button"],
mux-player.no-controls [part~="top-play-button"] {
  display: none !important;
}
</style>

<ProjectOverlay />

<style>
  /* Shared Variables */
  :root {
    --line: #e6e6e6;
  }

  /* Grid Layout */
  .workRow {
    font-family: var(--font);
    color: var(--text);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .workItem {
    display: grid;
    grid-template-rows: auto auto;
    align-content: start;
    margin-bottom: 100px;
    touch-action: manipulation; /* removes 300 ms tap delay on mobile */
  }

  .cardBody {
    display: block;
  }

  /* Card Media */
  .media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
    text-decoration: none;
  }

  .workItem[data-orientation="portrait"] .cardBody {
    width: 91%;
    margin-inline: auto;
  }

  .workItem[data-orientation="portrait"] .media {
    aspect-ratio: 9 / 16;
  }

  .workItem[data-orientation="portrait"] .metaGrid {
    width: 100%;
    text-align: left;
  }

  @media (min-width: 901px) {
    .workItem[data-orientation="portrait"] .cardBody {
      width: fit-content;
      max-width: 91%;
    }

    .workItem[data-orientation="portrait"] .media {
      height: min(78vh, 820px);
      width: auto;
    }
  }

  .vid {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 200ms ease;
  }

  .workItem[data-orientation="portrait"] .vid {
    object-fit: contain;
    background: #000;
  }

  :global(.workItem[data-orientation="portrait"] .muxFrame) {
    --media-object-fit: contain !important;
    background: #000;
  }

  .watch {
    position: absolute;
    top: 0;
    left: 10px;
    font-size: 22px;
    text-transform: lowercase;
    letter-spacing: 0.01em;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  /* Card Metadata */
  .metaGrid {
    display: block;
    padding-top: 11px;
    font-size: 9px;
    letter-spacing: 0.01em;
  }

  .meta {
    line-height: 1.25;
  }

  .metaInline {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 5px 5px;
  }

  .metaRole {
    white-space: nowrap;
  }

  .metaYear {
    font-size: 0.9em;
    opacity: 0.8;
  }

  .project {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .media:focus-visible {
    outline: 2px solid #111;
    outline-offset: 3px;
  }

  /* Grid Responsive */
  @media (max-width: 900px) {
    .workRow {
      grid-template-columns: 1fr;
    }

    .workItem + .workItem {
      border-left: 0;
    }

    .metaGrid {
      font-size: 9px;
    }

    .watch {
      font-size: 0.6rem;
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vid {
      transition: none;
    }
  }
</style>
