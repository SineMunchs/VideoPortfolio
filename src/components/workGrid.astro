---
import items from "../data/work.json";

type WorkItem = {
  id: string;
  href: string;
  poster: string;
  videoSrc: string;
  videoWebm?: string;
  tag?: string;
  role: string;
  title: string;
  year: string;
  project: string;
  overlay?: string;
};

const workItems = items as WorkItem[];
---

<!--  https://www.bittercreek.studio/projects/ghostpoet-oh-lord-->

<section class="workRow" aria-label="Selected work">
  {
    workItems.map((item) => (
      <article
        class="workItem"
        id={item.id}
        tabindex="0"
        data-id={item.id}
        data-project={item.project}
        data-title={item.title}
        data-year={item.year}
        data-role={item.role}
        data-tag={item.tag ?? "watch"}
        data-video={item.videoSrc}
        data-video-webm={item.videoWebm ?? ""}
        data-poster={item.poster}
        data-href={item.href}
        data-overlay-text={item.overlay ?? ""}
      >
        <a class="media" href={item.href} aria-label={`Open ${item.project}`}>
          <video
            class="vid"
            muted
            playsinline
            preload="metadata"
            poster={item.poster}
            data-hover-play
          >
            {item.videoWebm ? (
              <source src={item.videoWebm} type="video/webm" />
            ) : null}
            <source src={item.videoSrc} type="video/mp4" />
          </video>

          <span class="watch">{item.tag ?? "watch"}</span>
        </a>

        <div class="metaGrid" aria-label="Project metadata">
          <div class="meta">{item.role}</div>
          <div class="meta metaInline">
            <span>{item.title}</span>
            <span class="metaYear">{item.year}</span>
          </div>
          <div class="meta project">{item.project}</div>
        </div>
      </article>
    ))
  }
</section>

<div class="overlay" data-overlay aria-hidden="true">
  <div class="overlay-panel">
    <button
      class="overlay-close"
      type="button"
      data-overlay-close
      aria-label="Close project overlay"
    >
      close
    </button>

    <div class="overlay-body">
      <div class="overlay-media">
        <video
          class="overlay-video"
          playsinline
          controls
          muted
          autoplay
          data-overlay-video
        >
          <source data-overlay-source-webm type="video/webm" />
          <source data-overlay-source type="video/mp4" />
        </video>
        <a class="overlay-link" href="#" data-overlay-link>open project</a>
      </div>

      <div class="overlay-meta">
        <div class="overlay-tag" data-overlay-tag></div>
        <div class="overlay-project" data-overlay-project></div>
        <div class="overlay-sub" data-overlay-sub></div>

        <div class="overlay-copy">
          <p data-overlay-description></p>
      </div>
    </div>
  </div>
</div>


<script is:inline>
  (() => {
    const overlay = document.querySelector("[data-overlay]");
    const closeBtn = overlay?.querySelector("[data-overlay-close]");
    const tagEl = overlay?.querySelector("[data-overlay-tag]");
    const projectEl = overlay?.querySelector("[data-overlay-project]");
    const subEl = overlay?.querySelector("[data-overlay-sub]");
    const descriptionEl = overlay?.querySelector("[data-overlay-description]");
    const linkEl = overlay?.querySelector("[data-overlay-link]");
    const videoEl = overlay?.querySelector("[data-overlay-video]");
    const sourceEl = overlay?.querySelector("[data-overlay-source]");
    const webmSourceEl = overlay?.querySelector("[data-overlay-source-webm]");

    const openFullscreen = async () => {
      if (!videoEl) return;
      const el = videoEl;
      const request =
        el.requestFullscreen ||
        el.webkitRequestFullscreen ||
        el.msRequestFullscreen;

      if (request) {
        try {
          await request.call(el);
          await el.play?.();
          return;
        } catch {}
      }

      if (linkEl?.href) {
        window.open(linkEl.href, "_blank", "noopener,noreferrer");
      }
    };

    const updateOverlay = (item) => {
      if (!overlay || !videoEl || !sourceEl) return;

      const tag = item.dataset.tag || "watch";
      const project = item.dataset.project || "";
      const role = item.dataset.role || "";
      const year = item.dataset.year || "";
      const title = item.dataset.title || "";
      const href = item.dataset.href || "#";
      const poster = item.dataset.poster || "";
      const video = item.dataset.video || "";
      const videoWebm = item.dataset.videoWebm || "";
      const overlayText = item.dataset.overlayText || "";

      if (tagEl) tagEl.textContent = tag;
      if (projectEl) projectEl.textContent = project || title;
      if (subEl)
        subEl.textContent = [role, title, year].filter(Boolean).join(" • ");
  if (descriptionEl) descriptionEl.innerHTML = overlayText; // <-- changed
      if (linkEl) linkEl.href = href;

      if (poster) {
        videoEl.setAttribute("poster", poster);
      } else {
        videoEl.removeAttribute("poster");
      }

      if (webmSourceEl) {
        if (videoWebm) {
          webmSourceEl.src = videoWebm;
        } else {
          webmSourceEl.removeAttribute("src");
        }
      }

      sourceEl.src = video;
      videoEl.load();
    };

    const openOverlay = (item) => {
      if (!overlay) return;
      updateOverlay(item);
      overlay.classList.add("is-open");
      overlay.removeAttribute("aria-hidden");
      requestAnimationFrame(() => {
        try {
          videoEl?.play();
        } catch {}
      });
    };

    const closeOverlay = () => {
      if (!overlay) return;
      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      videoEl?.pause();
    };

    closeBtn?.addEventListener("click", closeOverlay);

    overlay?.addEventListener("click", (e) => {
      if (e.target === overlay) closeOverlay();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeOverlay();
    });

    linkEl?.addEventListener("click", (e) => {
      e.preventDefault();
      openFullscreen();
    });

    document.querySelectorAll(".workItem").forEach((item) => {
      const handleOpen = (e) => {
        if (e.type === "mousedown" && e.button !== 0) return;
        e.preventDefault();
        openOverlay(item);
      };

      item.addEventListener("mousedown", handleOpen);
      item.addEventListener("click", (e) => e.preventDefault());
      item.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openOverlay(item);
        }
      });
    });

    document.querySelectorAll("video[data-hover-play]").forEach((v) => {
      const play = async () => {
        try {
          v.muted = true;
          v.currentTime = 0;
          await v.play();
        } catch {}
      };

      const stop = () => {
        v.pause();
        v.currentTime = 0;
      };

      const wrap = v.closest("a");
      const targets = [v, wrap].filter(Boolean);

      targets.forEach((t) => {
        t.addEventListener("mouseenter", play);
        t.addEventListener("mouseleave", stop);
        t.addEventListener("focusin", play);
        t.addEventListener("focusout", stop);
      });
    });
  })();
</script>

<style>
  :root {
    --text: #111;
    --line: #e6e6e6;

    --gutter: 10px;
    --section-mt: 1px;
  }

  .workRow {
    font-family: var(--font);
    color: var(--text);

    margin-top: var(--section-mt);

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .workItem {
    display: grid;
    grid-template-rows: auto auto;
    align-content: start;
    margin-bottom: 100px;
  }

  .media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
    text-decoration: none;
  }

  .vid {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 200ms ease;
  }

  .watch {
    position: absolute;
    top: 0px;
    left: 10px;

    font-size: 22px;
    text-transform: lowercase;
    letter-spacing: 0.01em;

    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .metaGrid {
    display: grid;
    grid-template-columns: 1fr 1.6fr 0.8fr;
    gap: 18px;
    align-items: start;
    border-top: 1px solid var(--line);

    font-size: 14px;
    letter-spacing: 0.01em;
  }

  .meta {
    line-height: 1.25;
  }

  .metaInline {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .metaYear {
    font-size: 0.9em;
    opacity: 0.8;
  }

  .project {
    font-size: 44px;
    margin-top: -10px;
    font-weight: 600;
    letter-spacing: 0.01em;
    transform: translateX(-8px);
  }

  .media:focus-visible {
    outline: 2px solid #111;
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .workRow {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .workItem + .workItem {
      border-left: 0;
    }

    .metaGrid {
      grid-template-columns: auto auto auto;
      gap: 12px;
      align-items: center;
      font-size: 12px;
      white-space: nowrap;
    }

    .project {
      justify-self: start;
      font-size: 32px;
      transform: translateX(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vid {
      transition: none;
    }
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    justify-content: flex-end;
    background: rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(1px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .overlay-panel {
    position: relative;
    width: min(720px, 95vw);
    height: 100%;
    background: #f8f8f8;
    color: #111;
    padding: 32px 28px 40px;
    transform: translateX(100%);
    transition: transform 280ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
    overflow-y: auto;
    font-family: var(--font);
    box-shadow: -12px 0 40px rgba(0, 0, 0, 0.15);
  }

  .overlay.is-open .overlay-panel {
    transform: translateX(0);
  }

  .overlay-close {
    position: absolute;
    top: 16px;
    right: 16px;
    border: 0;
    background: none;
    text-transform: lowercase;
    font-size: 14px;
    cursor: pointer;
    color: inherit;
    letter-spacing: 0.01em;
  }

  .overlay-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 12px;
    align-items: start;
  }

  .overlay-meta {
    display: grid;
    gap: 10px;
  }

  .overlay-tag {
    font-size: 14px;
    text-transform: lowercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  .overlay-project {
    font-size: 44px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.05;
  }

  .overlay-sub {
    font-size: 14px;
    letter-spacing: 0.01em;
    line-height: 1.3;
    opacity: 0.8;
  }

  .overlay-media {
    display: grid;
    gap: 12px;
    position: sticky;
    top: 16px;
  }

  .overlay-video {
    width: 100%;
    border: 1px solid #e6e6e6;
    background: #000;
  }

  .overlay-link {
    font-size: 14px;
    letter-spacing: 0.01em;
    text-transform: lowercase;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    width: fit-content;
  }

  .overlay-copy {
    display: grid;
    gap: 12px;
    font-size: 14px;
    line-height: 1.45;
    letter-spacing: 0.01em;
  }

  .overlay-copy p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .overlay-body {
      grid-template-columns: 1fr;
    }

    .overlay-media {
      position: static;
    }

    .overlay-panel {
      width: 100%;
    }
  }
</style>
