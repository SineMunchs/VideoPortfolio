      opacity 200ms ease;
  }

  .menu[open] .menu-item {
    transform: translateY(0);
    clip-path: polygon(0 100%, 100% 100%, 100% 0, 0 0);
    opacity: 1;
  }

  .menu[open] .menu-item:nth-child(1) { transition-delay: calc(var(--stagger) * 1); }
  .menu[open] .menu-item:nth-child(2) { transition-delay: calc(var(--stagger) * 2); }
  .menu[open] .menu-item:nth-child(3) { transition-delay: calc(var(--stagger) * 3); }

  .menu[data-closing="true"] .menu-item {
    transform: translateY(-100%);
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
    opacity: 0;
  }

  .menu[data-closing="true"] .menu-item:nth-child(1) { transition-delay: calc(var(--stagger) * 3); }
  .menu[data-closing="true"] .menu-item:nth-child(2) { transition-delay: calc(var(--stagger) * 2); }
  .menu[data-closing="true"] .menu-item:nth-child(3) { transition-delay: calc(var(--stagger) * 1); }

  .menu-item:hover {
