<nav class="nav" aria-label="Primary">
  <a class="brand" href="/work">Paddy Gomulski</a>

  <details class="menu" id="menu">
    <summary class="menu-summary">menu</summary>
    <div class="nav-menu_dropdown">
      <a class="menu-item" href="/work">work</a>
      <!-- <a class="menu-item" href="/directors">about</a> -->
      <a class="menu-item" href="/contact">contact</a>
    </div>
  </details>
</nav>

<script>
  (() => {
    const menu = document.getElementById("menu");
    if (!menu) return;

    const summary = menu.querySelector(".menu-summary");
    const links = menu.querySelectorAll(".menu-item");
    if (!summary) return;

    // Keep this in sync with --dur in CSS
    const CLOSE_MS = 420;

    const isOpen = () => menu.hasAttribute("open");
    const isClosing = () => menu.dataset.state === "closing";

    const closeWithAnimation = () => {
      if (!isOpen() || isClosing()) return;

      menu.dataset.state = "closing";

      window.setTimeout(() => {
        menu.removeAttribute("open");
        delete menu.dataset.state;
      }, CLOSE_MS);
    };

    // Click on summary while open -> close with animation
    summary.addEventListener("click", (event) => {
      if (isOpen() && !isClosing()) {
        event.preventDefault();
        closeWithAnimation();
      }
      // when closed, browser will open the <details> as normal
    });

    // Close when a menu link is clicked
    links.forEach((link) => {
      link.addEventListener("click", closeWithAnimation);
    });

    // Click outside closes the menu
    document.addEventListener("click", (event) => {
      if (!isOpen()) return;
      if (menu.contains(event.target as Node)) return;
      closeWithAnimation();
    });

    // Escape closes the menu
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeWithAnimation();
      }
    });
  })();
</script>

<style>
:root {
  --ease: cubic-bezier(0.4, 0, 0.2, 1);
  --dur: 420ms;
  --stagger: 40ms;
}

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0;
    margin-bottom: var(--page-pad-block, 1rem);
    font-family: var(--font);
    color: #fff;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: difference;
  }

  .nav a,
  .nav summary {
    pointer-events: auto;
    color: inherit;
    text-decoration: none;
  }

  .brand {
    font-size: 12px;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .menu {
    position: relative;
  }

/* Trigger */
  .menu-summary {
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0;
    font-size: 14px;
    text-transform: lowercase;
    letter-spacing: 0.12em;
    line-height: 1.15;
    opacity: 0.95;
    transition: opacity 120ms var(--ease);
    list-style: none;
  }

  .menu-summary:hover,
  .menu-summary:focus-visible {
    opacity: 1;
  }

  .menu-summary::-webkit-details-marker {
    display: none;
  }

  /* Dropdown container */
  .nav-menu_dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms var(--ease);
  }

  /* Visible when opening or closing */
  .menu[open] .nav-menu_dropdown,
  .menu[data-state="closing"] .nav-menu_dropdown {
    pointer-events: auto;
    opacity: 1;
  }

  /* Individual items */
  .menu-item {
    font-size: 14px;
    text-transform: lowercase;
    letter-spacing: 0.12em;
    line-height: 1.15;
    transform: translateY(-100%);
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
    opacity: 0;
    transition:
      transform var(--dur) var(--ease),
      clip-path var(--dur) var(--ease),
      opacity 200ms ease;
  }

  /* Opening animation */
  .menu[open] .menu-item {
    transform: translateY(0);
    clip-path: polygon(0 100%, 100% 100%, 100% 0, 0 0);
    opacity: 1;
  }

  /* Stagger in */
  .menu[open] .menu-item:nth-child(1) { transition-delay: calc(var(--stagger) * 1); }
  .menu[open] .menu-item:nth-child(2) { transition-delay: calc(var(--stagger) * 2); }
  .menu[open] .menu-item:nth-child(3) { transition-delay: calc(var(--stagger) * 3); }

  /* Closing animation (reverse stagger) */
  .menu[data-state="closing"] .menu-item {
    transform: translateY(-100%);
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
    opacity: 0;
  }

  .menu[data-state="closing"] .menu-item:nth-child(1) { transition-delay: calc(var(--stagger) * 3); }
  .menu[data-state="closing"] .menu-item:nth-child(2) { transition-delay: calc(var(--stagger) * 2); }
  .menu[data-state="closing"] .menu-item:nth-child(3) { transition-delay: calc(var(--stagger) * 1); }

  .menu-item:hover {
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-item {
      transition: none !important;
      transform: none !important;
      clip-path: none !important;
      opacity: 1 !important;
    }
  }
</style>
