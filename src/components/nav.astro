<nav class="nav" aria-label="Primary">
  <a class="brand" href="/work">Paddy Gomulski</a>

  <details class="menu" id="menu">
    <summary class="menu-summary">menu</summary>

    <div class="nav-menu_dropdown">
      <a class="menu-item" href="/work">work</a>
      <a class="menu-item" href="/directors">about</a>
      <a class="menu-item" href="/contact">contact</a>
    </div>
  </details>
</nav>

<script>
  (() => {
    const details = document.getElementById("menu");
    if (!details) return;

    const summary = details.querySelector("summary");
    const links = details.querySelectorAll("a");
    const CLOSE_MS = 460;

    if (!summary) return;

    const closeWithAnimation = () => {
      if (!details.hasAttribute("open")) return;
      details.dataset.closing = "true";
      setTimeout(() => {
        details.removeAttribute("open");
        delete details.dataset.closing;
      }, CLOSE_MS);
    };

    summary.addEventListener("click", (e) => {
      if (details.hasAttribute("open") && !details.dataset.closing) {
        e.preventDefault();
        closeWithAnimation();
      }
    });

    links.forEach((a) => a.addEventListener("click", closeWithAnimation));

    document.addEventListener("click", (e) => {
      if (!details.hasAttribute("open")) return;
      if (details.contains(e.target)) return;
      closeWithAnimation();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeWithAnimation();
    });
  })();
</script>

