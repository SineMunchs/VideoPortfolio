---
const email = "paddyblog@gmail.com";
---
<footer class="footer">
  <div class="icon-row">
    <button
      type="button"
      class="footer-action tooltip-parent"
      id="copy-email"
      data-copy={email}
    >
      Email
      <span class="footer-tooltip">Email copied</span>
    </button>
    <span class="divider">/</span>
    <a
      href="https://www.instagram.com/paddygomulski/"
      target="_blank"
      rel="noopener"
      aria-label="Instagram"
      class="footer-action instagram-link"
    >
      Instagram
    </a>
  </div>
  <p>© Paddy Gomulski. All rights reserved.</p>
</footer>

<script>
  const btn = document.getElementById("copy-email");
  if (btn) {
    btn.addEventListener("mousedown", () => btn.classList.add("show-tooltip"));
    btn.addEventListener("mouseup", () => {
      setTimeout(() => btn.classList.remove("show-tooltip"), 400);
    });
    btn.addEventListener("mouseleave", () => btn.classList.remove("show-tooltip"));
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      } catch (err) {
        console.error("Failed to copy email", err);
      }
    });
  }
</script>

<style>
.footer {
  position: fixed;
left: var(--page-pad-inline);
right: var(--page-pad-inline);
bottom: 0;
width: auto;
padding: 0 0 var(--page-pad-block);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  font-family: var(--font);
  font-size: 0.6rem;
  box-sizing: border-box;
  color: #fff;
  mix-blend-mode: difference;
}
.icon-row {
  display: flex;
  align-items: center;
  gap: 0.27rem;
  margin-left: 0; /* Remove extra left margin for alignment */
}

.tooltip-parent {
  position: relative;
}

.footer-action,
.instagram-link {
  position: relative;
  margin: 0;
  padding: 0;
  border: none;
  background: none;
  color: inherit;
  cursor: pointer;
  font: inherit;
  text-decoration: none;
  text-transform: lowercase;
  user-select: none;
}

.footer-tooltip {
  visibility: hidden;
  opacity: 0;
  background: #fff;
  color: #2c2c2c;
  text-align: center;
  border-radius: 4px;
  padding: 0.2rem 0.6rem;
  position: absolute;
  left: 3rem;
  bottom: 120%;
  white-space: nowrap;
  font-size: 0.6rem;
  z-index: 200;
  transition: opacity 0.2s;
  pointer-events: none;
}

.tooltip-parent.show-tooltip .footer-tooltip {
  visibility: visible;
  opacity: 1;
}
.divider {
  margin: 0 0.3rem;
  display: inline;
}
.footer p {
  font-size: 0.6rem;
  margin-right: 0;
}
</style>
