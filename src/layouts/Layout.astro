---
import '../styles/global.css';

const { title = 'paddy gomulski' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script type="module" src="https://unpkg.com/@mux/mux-player@latest"></script>
    <link rel="icon" type="image/png" href="/paddy.png" />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
